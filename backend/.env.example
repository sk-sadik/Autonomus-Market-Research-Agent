# ============================
# Gemini API Key (required)
# ============================
GEMINI_API_KEY=

# ============================
# Search APIs (optional)
# ============================
TAVILY_API_KEY=

# ============================
# MongoDB Connection
# ============================
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=autonomous_market_research

# ============================
# CORS: public frontend URL(s), comma-separated for multiple origins.
# Leave empty for local development (allows all origins).
# ============================
FRONTEND_URL=