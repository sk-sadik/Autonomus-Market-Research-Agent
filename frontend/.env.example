# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# FASTAPI_BACKEND_URL: URL of the Python FastAPI backend.
# Local development default: http://127.0.0.1:8000
FASTAPI_BACKEND_URL=http://127.0.0.1:8000

# FRONTEND_URL: Public URL where this frontend is hosted (used for CORS on the backend).
FRONTEND_URL=
