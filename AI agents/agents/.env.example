# Required: your Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the model used by every agent (default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# ============================
# CORS: public frontend URL(s), comma-separated for multiple origins.
# Leave empty for local development (allows all origins).
# ============================
FRONTEND_URL=